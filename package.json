{
  "name": "obsidian-wiki-copilot",
  "version": "2.1.1-beta.9",
  "description": "Schema-aware, citation-first AI retrieval for persistent LLM Wiki vaults.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm test && pnpm build",
    "verify:brat-beta": "node scripts/verify-brat-beta-release.mjs",
    "deploy": "pnpm build && node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "llm-wiki",
    "retrieval",
    "ai"
  ],
  "author": "Wiki Copilot contributors",
  "license": "MIT",
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "0.14.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.16.0"
}
